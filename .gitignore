# ==========================================================
# IE 造价审报平台 / 小学期交付仓库 —— Git 忽略规则
# 目标：仓库只保留「源码 + 文档 + 脱敏样例」，不含任何
#       虚拟环境、依赖包、构建产物、本地数据库、个人隐私数据。
# ==========================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
*.egg-info/
*.egg
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ---------- 打包 / 构建产物 ----------
build/
dist/
dist-*/
*.spec.bak
*.exe
*.msi
*.pkg
*.msix
*.app
.manifest

# ---------- Node / 前端 ----------
